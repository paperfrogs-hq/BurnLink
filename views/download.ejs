<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="BurnLink CLI — In the workshop. A privacy-first command-line companion for sharing burn-after-reading files." />
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="BurnLink CLI — In the Workshop" />
    <meta property="og:description" content="A privacy-first command-line companion for sharing burn-after-reading files. Being built right now." />
    <meta property="og:url" content="<%= canonicalUrl %>" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href="<%= canonicalUrl %>" />

    <title>Download BurnLink CLI — In the Workshop</title>

    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background:
          radial-gradient(circle at top right, rgba(235, 88, 61, 0.1), transparent 26%),
          #0a0a0a;
        color: #fff;
        line-height: 1.6;
        overflow-x: hidden;
        min-height: 100vh;
      }
      .container { max-width: 1100px; margin: 0 auto; padding: 0 2rem; }

      /* Navbar */
      header {
        padding: 1.75rem 0; border-bottom: 1px solid #1e1e1e;
        position: sticky; top: 0; background: #0a0a0a; z-index: 100;
      }
      .header-content { display: flex; justify-content: space-between; align-items: center; }
      .logo { text-decoration: none; display: flex; align-items: center; }
      .logo img { height: 45px; width: auto; display: block; }
      nav { display: flex; gap: 2.5rem; }
      nav a { text-decoration: none; color: #666; font-size: 0.75rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; transition: color 0.2s; }
      nav a:hover, nav a.active { color: #fff; }

      /* Footer */
      footer { border-top: 1px solid #1e1e1e; padding: 3rem 0; margin-top: 4rem; }
      .footer-content { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 2rem; margin-bottom: 2rem; }
      .footer-section h3 { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.12em; font-weight: 600; margin-bottom: 1rem; color: #555; }
      .footer-section a { display: block; color: #777; text-decoration: none; font-size: 0.85rem; margin-bottom: 0.5rem; transition: color 0.2s; }
      .footer-section a:hover { color: #fff; }
      .footer-bottom { border-top: 1px solid #1e1e1e; padding-top: 1.5rem; color: #444; font-size: 0.78rem; }

      @media (max-width: 768px) {
        nav { gap: 1.5rem; }
        .header-content { flex-wrap: wrap; gap: 1rem; }
        .footer-content { grid-template-columns: 1fr; gap: 1.5rem; }
      }

      /* Hero */
      .hero {
        text-align: center;
        padding: 6rem 0 3rem;
      }
      .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.4rem 0.9rem;
        border: 1px solid rgba(235, 88, 61, 0.4);
        background: rgba(235, 88, 61, 0.08);
        color: #eb583d;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 1.5rem;
      }
      .badge .dot {
        width: 6px; height: 6px; border-radius: 50%;
        background: #eb583d;
        box-shadow: 0 0 8px #eb583d;
        animation: pulse 1.6s ease-in-out infinite;
      }
      @keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.55; transform: scale(0.85); }
      }
      .hero h1 {
        font-size: clamp(2.4rem, 6vw, 4rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1.1;
        margin-bottom: 1.25rem;
      }
      .hero h1 .accent { color: #eb583d; }
      .hero p.lead {
        max-width: 640px;
        margin: 0 auto 2rem;
        font-size: 1.15rem;
        color: #b0b0b0;
      }

      /* Version row */
      .version-row {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1rem;
        margin: 1.5rem auto 0;
        font-size: 0.82rem;
        color: #666;
        flex-wrap: wrap;
      }
      .ver-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: #0d0d0d;
        border: 1px solid #1e1e1e;
        padding: 0.3rem 0.65rem;
        border-radius: 999px;
        font-size: 0.78rem;
        color: #888;
      }
      .ver-pill .dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #4ade80;
        box-shadow: 0 0 8px rgba(74, 222, 128, 0.6);
      }
      .ver-pill strong { color: #fff; font-weight: 600; }
      .releases-link { color: #888; text-decoration: none; transition: color 0.15s; }
      .releases-link:hover { color: #eb583d; }

      /* Install cards */
      .install-grid {
        margin: 1.5rem auto 0;
        max-width: 760px;
        display: grid;
        gap: 0.85rem;
      }
      .install-card {
        background: #0d0d0d;
        border: 1px solid #1e1e1e;
        border-radius: 12px;
        padding: 1rem 1.1rem;
        transition: border-color 0.2s;
      }
      .install-card:hover { border-color: #2a2a2a; }
      .install-card-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 0.7rem;
      }
      .os-badge {
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        color: #fff;
      }
      .os-hint {
        font-size: 0.72rem;
        color: #555;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      }

      .install-note {
        margin: 0.7rem 0 0;
        font-size: 0.78rem;
        color: #666;
        line-height: 1.55;
      }
      .install-note code {
        background: #050505;
        border: 1px solid #1e1e1e;
        padding: 0.1rem 0.35rem;
        border-radius: 4px;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.75rem;
        color: #b0b0b0;
      }

      /* Command box */
      .command {
        position: relative;
        background: #050505;
        border: 1px solid #1e1e1e;
        border-radius: 8px;
        padding: 0.75rem 0.9rem;
        padding-right: 5rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.88rem;
        color: #d4d4d4;
        overflow-x: auto;
        white-space: nowrap;
      }
      .command .prompt {
        color: #eb583d;
        user-select: none;
        margin-right: 0.5rem;
      }
      .copy-btn {
        position: absolute;
        top: 50%;
        right: 0.5rem;
        transform: translateY(-50%);
        background: #1a1a1a;
        border: 1px solid #2a2a2a;
        color: #aaa;
        padding: 0.35rem 0.6rem;
        border-radius: 5px;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        cursor: pointer;
        transition: color 0.15s, border-color 0.15s, background 0.15s;
      }
      .copy-btn:hover {
        color: #fff;
        border-color: #eb583d;
        background: rgba(235, 88, 61, 0.08);
      }
      .copy-btn.copied {
        color: #4ade80;
        border-color: #4ade80;
        background: rgba(74, 222, 128, 0.08);
      }

      /* Then run */
      .next {
        margin: 4rem auto 0;
        max-width: 760px;
      }
      .next h2 {
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        color: #666;
        font-weight: 600;
        margin-bottom: 1.25rem;
        text-align: center;
      }
      .steps {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 0.85rem;
      }
      .step {
        background: #0d0d0d;
        border: 1px solid #1e1e1e;
        border-radius: 10px;
        padding: 1rem;
        transition: border-color 0.2s;
      }
      .step:hover { border-color: #2a2a2a; }
      .num {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.7rem;
        color: #eb583d;
        letter-spacing: 0.08em;
        margin-bottom: 0.5rem;
      }
      .step h3 {
        font-size: 0.95rem;
        font-weight: 600;
        margin-bottom: 0.6rem;
        color: #fff;
      }
      .step code {
        display: block;
        background: #050505;
        border: 1px solid #1e1e1e;
        padding: 0.5rem 0.7rem;
        border-radius: 6px;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.78rem;
        color: #d4d4d4;
        overflow-x: auto;
        white-space: nowrap;
      }

      @media (max-width: 640px) {
        .command { font-size: 0.78rem; padding: 0.65rem 0.8rem; padding-right: 4.5rem; }
        .os-hint { display: none; }
      }
    </style>
</head>
<body>
  <%- include("partials/header") %>

  <main class="container">
    <section class="hero">
      <h1>Install <span class="accent">BurnLink</span>.</h1>
      <p class="lead">
        One command. End-to-end encrypted, burn-after-read file sharing from your terminal.
      </p>

      <div class="version-row">
        <span class="ver-pill">
          <span class="dot"></span>
          latest: <strong style="margin-left:0.25rem;font-weight:600;">0.1.9</strong>
        </span>
        <a class="releases-link" href="https://github.com/Joy-Majumder/BurnLink-CLI/releases/latest" target="_blank" rel="noopener">
          All releases →
        </a>
      </div>

      <div class="install-grid">
        <div class="install-card">
          <div class="install-card-head">
            <span class="os-badge">macOS / Linux</span>
            <span class="os-hint">bash, zsh, fish</span>
          </div>
          <div class="command">
            <span class="prompt">$</span>
            <span id="cmd-mac">curl -fsSL https://burnlink.page/install.sh | sh</span>
            <button class="copy-btn" data-copy="cmd-mac">Copy</button>
          </div>
        </div>

        <div class="install-card">
          <div class="install-card-head">
            <span class="os-badge">Windows</span>
            <span class="os-hint">PowerShell 5+</span>
          </div>
          <div class="command">
            <span class="prompt">&gt;</span>
            <span id="cmd-win">irm https://burnlink.page/install.ps1 | iex</span>
            <button class="copy-btn" data-copy="cmd-win">Copy</button>
          </div>
        </div>

        <div class="install-card">
          <div class="install-card-head">
            <span class="os-badge">npm</span>
            <span class="os-hint">Node 18+</span>
          </div>
          <div class="command">
            <span class="prompt">$</span>
            <span id="cmd-npm">npm i -g burnlink</span>
            <button class="copy-btn" data-copy="cmd-npm">Copy</button>
          </div>
          <p class="install-note">
            If you get <code>EACCES</code>, your global npm prefix is owned by root.
            Switch to a user prefix:
            <code>npm config set prefix ~/.npm-global</code> then re-add
            <code>export PATH="$HOME/.npm-global/bin:$PATH"</code> to your shell rc.
          </p>
        </div>
      </div>
    </section>

    <section class="next">
      <h2>Then run</h2>
      <div class="steps">
        <div class="step">
          <div class="num">01</div>
          <h3>Activate</h3>
          <code>burnlink activate BURNLINK-…</code>
        </div>
        <div class="step">
          <div class="num">02</div>
          <h3>Send</h3>
          <code>burnlink upload ./secret.pdf</code>
        </div>
        <div class="step">
          <div class="num">03</div>
          <h3>Receive</h3>
          <code>burnlink download &lt;url&gt;</code>
        </div>
      </div>
    </section>
  </main>

  <%- include("partials/footer") %>

  <script>
    document.querySelectorAll(".copy-btn").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.dataset.copy;
        const el = document.getElementById(id);
        if (!el) return;
        try {
          await navigator.clipboard.writeText(el.textContent.trim());
          const orig = btn.textContent;
          btn.textContent = "Copied";
          btn.classList.add("copied");
          setTimeout(() => {
            btn.textContent = orig;
            btn.classList.remove("copied");
          }, 1200);
        } catch (_) {
          btn.textContent = "Press ⌘C";
        }
      });
    });
  </script>
</body>
</html>